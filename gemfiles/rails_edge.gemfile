# This file was generated by Appraisal

source "https://rubygems.org"

gem "rubocop"
gem "rubocop-minitest"
gem "rubocop-performance"
gem "activerecord", github: "rails/rails", branch: "main"
gem "sqlite3", platforms: :mri
gem "state_machines-activerecord"
gem "activerecord-jdbcsqlite3-adapter", platform: [:jruby, :truffleruby]
gem "activemodel", github: "rails/rails", branch: "main"
# railties has to come from the same source as activerecord/activemodel
# above; a separately-sourced `>= 7.1` constraint from rubygems.org
# conflicts with the activesupport version edge Rails requires.
gem "railties", github: "rails/rails", branch: "main"

platforms :mri do
  gem "padded_cell", "~> 0.2"
end

gemspec path: "../"
